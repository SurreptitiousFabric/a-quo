{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SurreptitiousFabric/a-quo/main/schemas/omarchy-plugin-risk-v1/local-policy.schema.json",
  "title": "A Quo Omarchy plugin local policy candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interactive_approval",
    "policy_id",
    "provider_handling",
    "required_provider_ids",
    "revision",
    "schema",
    "update_handling"
  ],
  "properties": {
    "interactive_approval": {
      "const": "require_consent"
    },
    "policy_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "provider_handling": {
      "$ref": "#/$defs/providerHandling"
    },
    "required_provider_ids": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "x-a-quo-order": "strict raw-ASCII order; duplicates forbidden"
    },
    "revision": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/jcsInteger"
        },
        {
          "minimum": 1
        }
      ]
    },
    "schema": {
      "const": "urn:a-quo:omarchy-plugin-local-policy:v1"
    },
    "update_handling": {
      "$ref": "#/$defs/updateHandling"
    }
  },
  "$defs": {
    "providerHandling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "incomplete",
        "missing_required",
        "not_run",
        "unsupported"
      ],
      "properties": {
        "error": {
          "$ref": "common.schema.json#/$defs/policyDisposition"
        },
        "incomplete": {
          "$ref": "common.schema.json#/$defs/policyDisposition"
        },
        "missing_required": {
          "$ref": "common.schema.json#/$defs/policyDisposition"
        },
        "not_run": {
          "$ref": "common.schema.json#/$defs/policyDisposition"
        },
        "unsupported": {
          "$ref": "common.schema.json#/$defs/policyDisposition"
        }
      }
    },
    "updateHandling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indeterminate_comparison"
      ],
      "properties": {
        "indeterminate_comparison": {
          "$ref": "common.schema.json#/$defs/policyDisposition"
        }
      }
    }
  },
  "x-a-quo-semantic": "closed declarative policy only; no script, arbitrary expression, unattended allow, trusted/safe result, or caller-controlled prompt text"
}
