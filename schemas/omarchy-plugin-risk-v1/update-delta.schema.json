{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SurreptitiousFabric/a-quo/main/schemas/omarchy-plugin-risk-v1/update-delta.schema.json",
  "title": "A Quo Omarchy plugin update delta candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files",
    "fresh_consent_required",
    "plugin_id",
    "previous_publisher_evidence_sha256",
    "previous_structural_record_sha256",
    "previous_subject",
    "providers",
    "publisher_continuity",
    "publisher_evidence_sha256",
    "schema",
    "structural_record_sha256",
    "subject",
    "version"
  ],
  "properties": {
    "files": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/fileDelta"
      },
      "x-a-quo-order": "strictly ascending path"
    },
    "fresh_consent_required": {
      "type": "boolean"
    },
    "plugin_id": {
      "enum": [
        "unchanged",
        "changed"
      ]
    },
    "previous_publisher_evidence_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "previous_structural_record_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "previous_subject": {
      "$ref": "common.schema.json#/$defs/manifestSubject"
    },
    "providers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/providerDelta"
      },
      "x-a-quo-order": "strictly ascending provider_id; sorted union of previous and current provider bindings; ghost provider deltas forbidden by cross-record validation"
    },
    "publisher_continuity": {
      "enum": [
        "matched",
        "mismatched",
        "not_checked"
      ]
    },
    "publisher_evidence_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "schema": {
      "const": "urn:a-quo:omarchy-plugin-update-delta:v1"
    },
    "structural_record_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/manifestSubject"
    },
    "version": {
      "enum": [
        "upgrade",
        "equal",
        "downgrade"
      ]
    }
  },
  "$defs": {
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableFileState": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/fileState"
        },
        {
          "type": "null"
        }
      ]
    },
    "fileDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "current",
        "path",
        "previous"
      ],
      "properties": {
        "change": {
          "enum": [
            "added",
            "removed",
            "content_changed",
            "mode_changed",
            "content_and_mode_changed"
          ]
        },
        "current": {
          "$ref": "#/$defs/nullableFileState"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "previous": {
          "$ref": "#/$defs/nullableFileState"
        }
      },
      "x-a-quo-semantic": "change tag is recomputed from previous/current content digest and mode"
    },
    "providerDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_native_report_sha256",
        "previous_native_report_sha256",
        "provider_id"
      ],
      "properties": {
        "current_native_report_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "previous_native_report_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "provider_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        }
      },
      "x-a-quo-semantic": "previous/current native-report digests are required-nullable and each must exactly match the corresponding retained native-report binding when present; every retained old or current provider binding has one provider delta; a provider ID absent from both binding lists is invalid during cross-record validation; A Quo does not infer behavioural changes from opaque report bytes"
    }
  },
  "x-a-quo-semantic": "plugin_id has only unchanged/changed states and version has only upgrade/equal/downgrade states; both are derived from the two valid manifest subjects. SemVer comparison uses precedence and ignores build metadata. publisher_continuity is derived from the two publisher-evidence records. Exact file deltas and fresh_consent_required are recomputed; old/new evidence digests and previous/current native-report bindings are cross-checked. The provider-delta union is capped at 32 entries. Any provider delta makes fresh_consent_required true, but report-byte differences are not translated into behavioural claims"
}
